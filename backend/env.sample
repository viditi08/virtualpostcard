# Copy this file to backend/.env and fill in the blank values.
# preview/server.py and the FastAPI server both read backend/.env.
# Do not commit backend/.env. It holds your mail password.

MONGO_URL=mongodb://localhost:27017
DB_NAME=whimsy_post
CORS_ORIGINS=*

# Gmail (free, from your own inbox):
#   1. Turn on 2-Step Verification at https://myaccount.google.com/security
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Put the 16-character App Password in SMTP_PASSWORD
#   4. Restart the server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# The public site, with no trailing slash. Emails then include
# https://your-site/#card=... which anyone can open.
# Leave this blank on your computer. On Render, leave it blank too:
# Render sets RENDER_EXTERNAL_URL and the studio uses that.
PUBLIC_BASE_URL=
